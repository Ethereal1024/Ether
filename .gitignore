# Ether — workspace root .gitignore
#
# Two kinds of thing are ignored here: things that are regenerated (build
# output, probe logs) and things that must stay on disk but must never be
# published (the .clc session logs).

# ── session logs ───────────────────────────────────────────────────────────
# `*.clc` next to the tree are local agent/session transcripts.  They are the
# development history, not sources: keep them, never commit them.
*.clc

# ── build output (regenerated by `npm run build` / `npm run dist`) ─────────
node_modules/
dist/
release/

# ── our own adb copy (regenerated by `npm run dist`, Google's binary) ──────
# `bin/cli.mjs --fetch-adb` writes `platform-tools/<plat>/adb` (+ NOTICE.txt)
# here so a package carries the one dependency it cannot work without.  It is
# Google's binary under the Android SDK terms: fetch it at package time, never
# commit it, and never hand-edit it.
app/resources/platform-tools/

# ── C relay ────────────────────────────────────────────────────────────────
# Built by c-relay/build.sh (host) and by the NDK cross compiler (aarch64);
# c-relay/_run/ is wired-moonlight.sh's scratch dir.
c-relay/udp2tcp
c-relay/udp2tcp.aarch64
c-relay/_run/

# ── dev harness output (regenerated by app/tools/ui-probe.sh, ui-live.sh) ──
app/tools/_ui_app.log
app/tools/_ui_build.log
app/tools/_ui_live_app.log
app/tools/_ui_live_build.log
app/tools/_ui_report.txt
app/tools/_ui_live_report.txt
app/tools/_ui_shots/
app/tools/ui-probe.html
app/tools/ui-probe-fake.js
app/tools/ui-probe-run.js

# ── misc ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
